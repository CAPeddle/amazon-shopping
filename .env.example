# Local development only. The deployed service reads
# ~/.config/amazon-nl-mcp/env plus a systemd credential for the token;
# see deploy/env.example.

AMAZON_MCP_AUTH_TOKEN=replace-me-with-32-random-characters
AMAZON_MCP_HOST=127.0.0.1
AMAZON_MCP_PORT=8765
AMAZON_MCP_LOG_FORMAT=console
AMAZON_MCP_LOG_LEVEL=DEBUG
