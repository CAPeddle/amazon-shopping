# Optional: reach the service from containers without the service itself ever
# binding anything but loopback. Enable with:
#
#   install -Dm644 deploy/amazon-nl-mcp-bridge.{socket,service} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now amazon-nl-mcp-bridge.socket
#
# Prefer `network_mode: host` on the calling container over this if you can.

[Unit]
Description=Bridge listener for amazon-nl-mcp (containers only)

[Socket]
ListenStream=172.17.0.1:8765
# docker0 may not exist yet at boot; IP_FREEBIND lets the bind succeed anyway.
FreeBind=true
NoDelay=true

[Install]
WantedBy=sockets.target
