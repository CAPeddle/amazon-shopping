# Copy to ~/.config/amazon-nl-mcp/env  (chmod 600).
# The bearer token does NOT belong here — put it in
# ~/.config/amazon-nl-mcp/auth_token (chmod 600); systemd passes it as a
# credential and the service reads it from there.

# --- where it listens -------------------------------------------------------
# 127.0.0.1 serves other processes on this box and nothing else. Use the docker
# bridge address (usually 172.17.0.1) if containers must reach it, and then list
# the Host header they will send in AMAZON_MCP_ALLOWED_HOSTS or MCP's
# DNS-rebinding protection answers 421.
AMAZON_MCP_HOST=127.0.0.1
AMAZON_MCP_PORT=8765
#AMAZON_MCP_ALLOWED_HOSTS=172.17.0.1:8765,host.docker.internal:8765

# --- browser ----------------------------------------------------------------
#AMAZON_MCP_HEADLESS=true
# Launch the system Google Chrome instead of Playwright's Chromium. Slightly
# less likely to be flagged; requires `playwright install chrome` or the .deb.
#AMAZON_MCP_BROWSER_CHANNEL=chrome
#AMAZON_MCP_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# Only for containers or a root service account, where Chromium's sandbox
# cannot start. Not needed for a normal user unit.
#AMAZON_MCP_BROWSER_NO_SANDBOX=false

# --- guardrails -------------------------------------------------------------
# Browser-backed tool calls per rolling minute. Amazon tolerates a human pace;
# raising this is the fastest way to earn a CAPTCHA.
AMAZON_MCP_RATE_LIMIT_PER_MINUTE=20
# How long to refuse browser work after Amazon serves an automation check.
AMAZON_MCP_BOT_WALL_COOLDOWN_S=120
# Set false for a read-only deployment: search and cart reads still work,
# amazon_add_to_cart refuses.
AMAZON_MCP_WRITE_ENABLED=true

# --- observability ----------------------------------------------------------
AMAZON_MCP_LOG_LEVEL=INFO
AMAZON_MCP_LOG_FORMAT=json
